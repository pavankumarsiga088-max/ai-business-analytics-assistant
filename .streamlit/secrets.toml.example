# Streamlit Community Cloud Secrets Template
# ----------------------------------------------------------------------
# For local testing, copy this file to: .streamlit/secrets.toml
# For Streamlit Community Cloud deployment:
#   1. Go to your app dashboard at https://share.streamlit.io/
#   2. Open App Settings -> Secrets
#   3. Paste and customize these key-value pairs
#
# IMPORTANT: Never commit actual API keys or passwords to version control.
# ----------------------------------------------------------------------

# Gemini API Configuration (Required for Natural Language Analytics & Insights)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-2.5-flash"

# Analytical Database Backend (duckdb or postgres)
DATABASE_BACKEND = "duckdb"

# Optional Remote PostgreSQL Configuration (Only if using PostgreSQL backend)
# POSTGRES_HOST = "your-remote-host.example.com"
# POSTGRES_PORT = 5432
# POSTGRES_DB = "postgres"
# POSTGRES_USER = "postgres"
# POSTGRES_PASSWORD = "your_postgres_password_here"
# POSTGRES_CONNECT_TIMEOUT = 10

# Resource Limits
MAX_QUERY_RESULT_ROWS = 10000
MAX_DISPLAYED_ROWS = 1000
QUERY_TIMEOUT_SECONDS = 30
